PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/sql-studio
MONGO_URI_TEST=mongodb://127.0.0.1:27017/sql-studio-test
JWT_SECRET=replace-with-a-secure-secret
ADMIN_JWT_SECRET=replace-with-a-separate-secure-admin-secret
ENABLE_LEGACY_JWT_AUTH=false
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=
CLERK_ADMIN_USER_IDS=
RUN_SUBSCRIPTION_CRON=false
CLERK_WAITLIST_MODE=false
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173
ADMIN_USER_ID=admin
ADMIN_PASSWORD=replace-with-a-strong-admin-password-or-bcrypt-hash

# Optional integrations
GEMINI_API_KEY=
# Alternative supported by Google Gemini docs; set only one key locally.
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
RAZORPAY_KEY_ID=
RAZORPAY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Email
EMAIL_PROVIDER=smtp
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=
SUPPORT_EMAIL=utsavjha93030@gmail.com
RESEND_API_KEY=
